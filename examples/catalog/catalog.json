{
  "schemaVersion": 1,
  "name": "Nova sample catalog",
  "plugins": [
    {
      "id": "com.example.sample",
      "name": "Sample plugin",
      "version": "1.0.0",
      "description": "A skill, a slash command, a hook, an MCP server and an MCP App panel.",
      "path": "sample-plugin",
      "author": "Nova examples",
      "categories": ["Examples"],
      "permissions": {
        "network": ["api.example.com"],
        "tools": {
          "plugin:com.example.sample.fetch_status": {
            "action": "read"
          },
          "plugin:com.example.sample.panel_action": {
            "action": "write",
            "default": "ask"
          }
        },
        "actionDefaults": {
          "read": "allow",
          "write": "ask",
          "send": "ask",
          "delete": "deny",
          "execute": "ask"
        },
        "hooks": {
          "answersAsks": false
        },
        "ui": {
          "connectDomains": ["api.example.com"]
        }
      },
      "components": {
        "hooks": [
          {
            "id": "hook:com.example.sample.check-fetch",
            "event": "tool.pre"
          }
        ],
        "uiEntryPoints": [
          {
            "kind": "global",
            "title": "Sample panel"
          },
          {
            "kind": "thread",
            "title": "Sample panel"
          }
        ]
      },
      "digest": "73e8215f488781180bd2e8dfd1a97324c85c208ed1062200df756aaf17d83a37"
    }
  ],
