{
  "manifest_version": "0.3",
  "name": "nova-hello",
  "display_name": "Hello (sample bundle)",
  "version": "1.0.0",
  "description": "A sample MCP bundle for Nova: one stdio server with a greeting tool and no dependencies.",
  "author": { "name": "Nova contributors" },
  "license": "AGPL-3.0-or-later",
  "server": {
    "type": "node",
    "entry_point": "server/index.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.mjs"],
      "env": {
        "HELLO_GREETING": "${user_config.greeting}",
        "HELLO_API_KEY": "${user_config.api_key}",
        "HELLO_NOTES_DIR": "${user_config.notes_dir}"
      }
    }
  },
  "user_config": {
    "greeting": {
      "type": "string",
      "title": "Greeting",
      "description": "The word the greet tool starts with.",
      "default": "Hello"
    },
    "api_key": {
      "type": "string",
      "title": "API key",
      "description": "A made-up key; the server only reports whether one is set.",
      "sensitive": true
    },
    "notes_dir": {
      "type": "directory",
      "title": "Notes folder",
      "description": "A folder the server may read (it never does; this shows how folders are granted)."
    }
  },
  "compatibility": {
    "platforms": ["darwin", "linux", "win32"],
    "runtimes": { "node": ">=22.0.0" }
  },
  "tools": [
    { "name": "greet", "description": "Greet someone by name" },
    { "name": "settings_check", "description": "Report which settings are set" }
  ]
}
