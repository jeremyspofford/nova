    "text/faint": "#7a838e",
    "border/subtle": "#dfe2e6",
    "border/strong": "#9aa3ad",
    "accent/primary": "#2f5fb3",
    "accent/secondary": "#6a4fb3",
    "status/ok": "#2e7d4f",
    "status/working": "#2f5fb3",
    "status/waiting": "#5f6873",
    "status/attention": "#a8620c",
    "status/error": "#b3261e",
    "orb/core": "#3fa7a0",
    "orb/glow": "rgba(63, 167, 160, 0.35)",
    "orb/listening": "#5cc2bb",
    "orb/attention": "#d99a3c",
