{
  "api": 1,
  "entry": "extension.js",
  "permissions": {
    "network": ["api.example.com"],
    "fs": ["${extensionData}"],
    "secrets": ["greeting"],
    "commands": ["hello.greet"],
    "panels": [
      {
        "id": "hello.panel",
        "title": "Hello",
        "resource": "ui://hello/panel",
        "entryPoint": "global",
        "file": "panels/hello.html",
        "connectDomains": ["api.example.com"]
      }
    ],
    "tools": {
      "greet": { "action": "read", "default": "allow" },
      "save_note": { "action": "write" },
      "check_status": { "action": "read", "default": "allow" }
    },
    "hooks": [
      { "id": "note-greetings", "event": "tool.post", "matcher": "ext:com.example.hello/greet" }
    ],
    "events": ["tool.call"]
  }
}
