*.pyc
__pycache__/
*.egg-info/
.pytest_cache/
.env
.env.local
.DS_Store
node_modules/
dist/
build/
.venv/
venv/
data/
.claude/
.worktrees/

# compiled config artifacts (vite prefers .js over .ts — a stale one shadows the real config)
frontend/vite.config.js
frontend/vite.config.d.ts
*.tsbuildinfo
frontend/dev-dist/
frontend/public/mockups/

# wake-word training artifacts (audio corpus + venv are local-only)
tools/wake-training/.venv/
tools/wake-training/data/

# ServiceAccount credential for Nova's runtime (workloads/setup.sh writes it)
data/runtime/

# uv's lockfile. Nothing builds from it — no Dockerfile, compose
# service or Makefile target runs uv, and pyproject has no [tool.uv].
# Committing a lockfile the build ignores is a second dependency
# statement that drifts silently from the one pip actually reads.
# Kept on disk, out of git, until something consumes it.
backend/uv.lock

# Same rule for the backup worker's: nothing BUILDS from it (novabundle.py
# runs inside the already-built core image, which locks its own deps in
# services/core/uv.lock). It exists only because running the suite with
# `uv run --project deploy/backup pytest` writes one. Left untracked it would
# be a file git calls neither tracked nor ignored, which the backup's own
# host-path scan refuses R2_UNCLASSIFIED — so it is ignored, deliberately.
deploy/backup/uv.lock

# Coverage output. An artifact of running the suite, not a statement about it —
# and it changes on every run, so tracking it makes every test run a diff.
backend/.coverage
frontend/coverage/

# e2e run artifacts: traces, the HTML report, and the signed-in browser state
# scenario 1 saves for the scenarios after it. The screenshot BASELINES under
# tests/e2e/__screenshots__/ are deliberately NOT ignored — they are what the
# next run diffs against.
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.auth/

# The isolated e2e stack: generated throwaway secrets for the nova-e2e
# project (tests/e2e/isolated.sh). Never deploy/.env, never committed.
tests/e2e/.isolated/

# S41: the backup passphrase and the bundles it seals. A bundle carries every
# secret this machine has, and the passphrase is the only thing that opens
# one — neither is ever a tracked file.
deploy/.backup-passphrase
deploy/.backup-passphrase.lock/
deploy/backups/

# S41 move markers: local state of THIS machine, never committed.
deploy/.moved
deploy/tailscale/MOVED_TO
