{
  "TCP": {
    "443": { "HTTPS": true },
    "8443": { "HTTPS": true },
    "8123": {
      "TCPForward": "home-assistant:8123",
      "TerminateTLS": "${TS_CERT_DOMAIN}"
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": { "Proxy": "http://web:80" }
      }
    },
    "${TS_CERT_DOMAIN}:8443": {
      "Handlers": {
        "/": { "Proxy": "http://ntfy:80" }
      }
    }
  }
}
