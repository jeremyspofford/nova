POSTGRES_PASSWORD=nova-dev-password
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LOG_LEVEL=INFO

# Admin token — REQUIRED before exposing Nova beyond this machine
# (tailscale serve, tunnels). Empty = open, localhost-only dev. Applies to
# REMOTE devices; browsers on this machine stay tokenless (see
# NOVA_TRUST_LOCALHOST). Onboard phones via Settings → Phone setup (QR).
# Generate one: openssl rand -hex 24
NOVA_AUTH_TOKEN=

# Set false to require the token even from this machine — do this if a
# host-side PUBLIC tunnel (e.g. cloudflared on the host) points at :8080,
# because the tunnel's requests look local.
#NOVA_TRUST_LOCALHOST=true

# ── Tailscale sidecar (optional; docker compose --profile tailscale up -d)
# Auth key from https://login.tailscale.com/admin/settings/keys — used once,
# then node identity lives in the tailscale_state volume. Nova appears at
# https://nova.<tailnet>.ts.net (enable MagicDNS + HTTPS certificates in the
# tailnet admin console, one time).
#TS_AUTHKEY=tskey-auth-...
# Instance-internal secret for the bundled SearXNG search service (no signup —
# any random string; e.g. `openssl rand -hex 16`)
SEARXNG_SECRET=change-me-random-string

# ── GPU (bundled Ollama) ────────────────────────────────────────────────
# The inference-control sidecar merges docker-compose.gpu.yml automatically
# when the docker NVIDIA runtime is present. OLLAMA_GPU=off opts out;
# OLLAMA_GPU=on forces it (e.g. Docker Desktop setups that support --gpus
# without advertising an nvidia runtime).
#OLLAMA_GPU=auto
# On NVIDIA machines, uncomment so manual host-side `docker compose`
# commands merge the same GPU override the sidecar uses:
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# ── Memory storage ──────────────────────────────────────────────────────
# Where Nova's markdown memory lives on the host. Any path plain files can
# live works: a NAS mount, an Obsidian vault folder, another disk. Restart
# with `docker compose up -d backend` after changing.
#NOVA_MEMORY_DIR=./data/memory

# ── Model storage ───────────────────────────────────────────────────────
# Where the bundled model WEIGHTS live (Ollama LLMs, Kokoro voice, Whisper
# STT). Unset = default docker-managed volumes. Point it at an external SSD,
# a NAS mount, or a bigger disk to save space or share between machines — use
# an ABSOLUTE path; it lays out $NOVA_MODELS_DIR/{ollama,kokoro,whisper}.
#NOVA_MODELS_DIR=/mnt/ssd/nova-models
#
# The Settings → Inference toggle relocates the bundled Ollama automatically.
# To also relocate the voice profile (or any manual `docker compose up`), add
# the override to COMPOSE_FILE — chain files with ':', including the GPU one
# if you use it (docker-compose.yml:docker-compose.gpu.yml:docker-compose.models.yml):
#COMPOSE_FILE=docker-compose.yml:docker-compose.models.yml

# ── Secrets store ───────────────────────────────────────────────────────
# Master key for Settings → Secrets (AES-GCM, base64, 32 bytes). Generate:
#   python3 -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Leave it UNSET on a single machine: the backend generates a key into the
# nova_state volume and warns that losing it loses the secrets. Set it — the
# SAME value on every host — before running a second instance against the
# same Postgres, or before restoring a backup bundle on a new machine
# (bundles exclude the key by default; keep an offline copy of it).
# Set it EARLY. Once secrets exist under a generated key, a NOVA_SECRET_KEY
# that differs from it is refused rather than silently applied — adopting it
# then means re-entering every value, because ciphertext is worthless
# without the key that wrote it.
#NOVA_SECRET_KEY=

# The Web Push contact address is NOT an env var. It is
# Settings → Notifications → Web Push contact address (notify.webpush.contact)
# — a setting, so it applies on the next push instead of the next rebuild.
# Set a real address: Apple refuses a push whose VAPID contact is not
# routable, with a bare 403 and no explanation.

# Shared secret for the mcp-runner sidecar. Generate with:
#   python3 -c "import secrets;print(secrets.token_hex(24))"
# Unset means the runner refuses every request (fails closed).
NOVA_MCP_RUNNER_TOKEN=

# The HOST path of this repo, for services that pass bind-mount paths to the
# Docker daemon (inference-control starting sidecars, the coder's repo
# mount). The compose file falls back to ${PWD}, which is the DIRECTORY YOU
# RAN COMPOSE FROM — correct only when that is the repo root. Running
# `docker compose -f <path> up` from anywhere else silently resolves every
# relative bind mount against the wrong directory (this nearly wrote Home
# Assistant's config into the sidecar's own filesystem once). Pin it.
NOVA_HOST_ROOT=/home/jeremy/workspace/nova

# The uid:gid that owns the repo on the host. git-landing writes into .git
# as this user; the default of 1000:1000 matches a first-user Linux account
# and NOTHING ELSE. If your account is any other uid (second user, macOS,
# most CI), landings will write objects your own git cannot touch — the
# exact lockout the compose comment on git-landing records. `id -u`/`id -g`.
NOVA_UID=1000
NOVA_GID=1000
