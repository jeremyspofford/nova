[Unit]
Description=Nova agent daemon (novad)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/novad run
Restart=always
RestartSec=5
# 78 (EX_CONFIG) = not enrolled, or revoked (wiped, or a wipe that only
# partly succeeded): restarting cannot help either way.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
