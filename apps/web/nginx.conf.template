# The one origin the browser ever sees: static build here, /api relayed to
# core. Nothing else is exposed — gateway and memory are not reachable from a
# browser at all.
#
# ── Temporary public exposure gate ──────────────────────────────────────
# This file is an envsubst TEMPLATE (nginx:alpine's built-in
# /etc/nginx/templates -> /etc/nginx/conf.d mechanism — see apps/web/
# Dockerfile), rendered to a real nginx conf at container start. The ONLY
# substitution that happens is NOVA_PUBLIC_GATE_TOKEN: the image sets
# NGINX_ENVSUBST_FILTER=^NOVA_ so envsubst only touches env vars whose name
# starts with NOVA_, which means every nginx `$var` below ($host, $scheme,
# $http_upgrade, $request_uri, $remote_addr, $core_upstream, $arg_token, the
# gate's own $gate_* map outputs, ...) is left completely alone. Verified by
# diffing the rendered conf against this file's own history — see
# apps/web/gate_test.sh.
#
# NOVA_PUBLIC_GATE_TOKEN is blank by default (gate OFF, and every location
# below behaves exactly as it did before this gate existed — install.sh
# deliberately does not generate this secret; it's opt-in for the one
# scenario where the operator is putting this origin on a public URL, e.g. a
# `cloudflared` quick tunnel, and cannot use Tailscale on the viewing
# device). Set it to a >=32-hex random value (same `openssl rand -hex 32`
# recipe as every other secret in deploy/.env.example) to turn the gate on:
# every request to every location on this server then needs a matching
# `nova_gate` cookie or gets a neutral 401 page, obtained by visiting
# `/gate?token=<the value you set>` once per browser.
#
# The comparison is plain nginx string equality (map, below) against a
# random secret with well over 128 bits of entropy — no timing-safe
# comparison, no session state, no rate limiting. That is enough here
# because the threat this defends against is "someone finds the tunnel URL
# and looks at it before the operator takes it back down", not a motivated
# attacker who can already read the token off the wire or has unlimited
# guesses against this one process. Rotate by changing the env var and
# recreating the container; the token also lives in plain sight in browser
# history the moment someone visits /gate?token=..., which is the other
# reason this is meant to be temporary.
#
# novad (the paired-device daemon) does NOT send cookies — pairing or
# connecting a device through a GATED public origin will not work, gate on
# or off doesn't matter, it never carries the nova_gate cookie. Pair and
# connect devices via the tailnet or localhost; this gate is for the browser
# path only.

# nginx's default map hash bucket is sized for short keys; a >=32-hex token
# used as a literal map key is longer than that default and nginx refuses to
# start ("could not build map_hash, you should increase
# map_hash_bucket_size") without this. 128 comfortably covers a 64-hex token
# with room to spare.
map_hash_bucket_size 128;

map $cookie_nova_gate $gate_cookie_ok {
    default 0;
    "${NOVA_PUBLIC_GATE_TOKEN}" 1;
}

# An empty configured token is the opt-in switch in its off position.
map "${NOVA_PUBLIC_GATE_TOKEN}" $gate_enabled {
    default 1;
    "" 0;
}

# Block iff the gate is enabled AND the cookie didn't match. String
# concatenation + map is nginx's stock idiom for an AND of two booleans.
map "$gate_enabled$gate_cookie_ok" $gate_block {
    default 0;
    "10" 1;
}

# The /gate login's own token check — same equality recipe as the cookie.
map $arg_token $gate_token_ok {
    default 0;
    "${NOVA_PUBLIC_GATE_TOKEN}" 1;
}

# Login only succeeds when the gate is enabled AND the token matched. (The
# two maps above already default an absent/empty value to 0 on their own;
# this makes the AND explicit instead of relying on that coincidence, so a
# `/gate?token=` with the gate off can never mint a working cookie.)
map "$gate_enabled$gate_token_ok" $gate_login_ok {
    default 0;
    "11" 1;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Fail-closed 401s render this neutral static page instead of Nova's own
    # login or any hint of what's behind the gate. Status stays 401 (no `=`
    # override) so this is still machine-checkable, not just human-readable.
    error_page 401 /gate-page.html;

    # Docker's embedded DNS. Resolving `core` through a variable (below) rather
    # than at config-load time buys two things: nginx starts even when core is
    # not up yet, and a recreated core container's new IP is picked up within
    # `valid=` instead of 502ing until nginx is restarted.
    resolver 127.0.0.11 ipv6=off valid=10s;

    # ── The gate itself ─────────────────────────────────────────────────

    # The static gate page. NOT behind $gate_block (that would recurse
    # through error_page into a redirect loop) — it is what a blocked
    # visitor is shown, so it must always be servable. `internal` keeps it
    # from being a second, ungated, always-200 route: it only answers as the
    # body of the 401 above, never as a direct 200.
    location = /gate-page.html {
        internal;
        access_log off;
    }

    # GET /gate?token=<T> — the only way to mint the cookie. Never logged:
    # the token rides in the URL, and this is the one place nginx sees it.
    location = /gate {
        access_log off;
        if ($gate_login_ok) {
            add_header Set-Cookie "nova_gate=${NOVA_PUBLIC_GATE_TOKEN}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=2592000" always;
            return 302 /;
        }
        return 401;
    }

    # Rail 12: `/health/live` flat and self-only on every service. web's own
    # compose healthcheck already asks `/` (proving nginx serves the app
    # shell), but the same flat path every other service answers on belongs
    # here too rather than being the one service without it — self-only means
    # nginx answers this itself, touching no upstream, so a red result here
    # can only ever mean nginx.
    #
    # This location IS behind the gate like everything else on this origin
    # (fail-closed means no carve-outs) — which means when the gate is on,
    # the web container's own Docker healthcheck (`GET /`, not this path,
    # see deploy/docker-compose.yml) reports unhealthy while ungated visitors
    # can't get in either, by design. That's a known, accepted side effect of
    # turning the gate on against the running stack, not a defect here.
    location = /health/live {
        include /etc/nginx/gate/gate_check.conf;
        default_type application/json;
        return 200 '{"status":"live"}';
    }

    # ── The two long-lived streams ─────────────────────────────────────────
    # Buffering here would hold tokens back until nginx felt like flushing,
    # which is exactly the "it looks hung then dumps everything" bug. The long
    # read timeout is for a model that thinks for minutes, or a multi-GB pull
    # between progress lines.

    location = /api/v1/chat/stream {
        include /etc/nginx/gate/gate_check.conf;
        set $core_upstream http://core:8000;
        proxy_pass $core_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        gzip off;
        chunked_transfer_encoding on;
    }

    location = /api/v1/models/pull {
        include /etc/nginx/gate/gate_check.conf;
        set $core_upstream http://core:8000;
        proxy_pass $core_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        gzip off;
        chunked_transfer_encoding on;
    }

    # The AI Quality run: a suite is a handful of REAL turns against a model,
    # minutes end to end — far past the 60s general-API read timeout below. It
    # streams one newline-delimited JSON line per finished case (see
    # services/core/app/evals_api.py POST /evals/run), so it needs the same
    # buffering-off, long-timeout treatment the pull stream gets, or nginx would
    # cut the run off mid-suite on the phone path.
    location = /api/v1/evals/run {
        include /etc/nginx/gate/gate_check.conf;
        set $core_upstream http://core:8000;
        proxy_pass $core_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        gzip off;
        chunked_transfer_encoding on;
    }

    # ── The daemon WebSocket ───────────────────────────────────────────────
    # A paired device (novad) holds an outbound WebSocket to core through this
    # one origin — the same origin the phone uses. This is the ONLY
    # Upgrade-aware location: it forwards the HTTP/1.1 Upgrade + Connection
    # headers so nginx switches the connection to a WebSocket instead of
    # buffering it as a normal request. Buffering off and a long read timeout
    # keep an idle-but-alive socket (the daemon heartbeats ~every 20s) from
    # being culled between frames. Same variable-upstream + server-level
    # resolver trick as the streams above, so a recreated core's new IP is
    # re-picked-up within `valid=` instead of 502ing until nginx restarts.
    #
    # Gated like everything else — see the novad comment up top: a paired
    # device sends no cookie, so this location 401s a device's connection
    # attempt whenever the gate is on. Pair/connect over the tailnet or
    # localhost instead.
    location = /api/v1/devices/ws {
        include /etc/nginx/gate/gate_check.conf;
        set $core_upstream http://core:8000;
        proxy_pass $core_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── Everything else on the API ─────────────────────────────────────────

    location /api/ {
        include /etc/nginx/gate/gate_check.conf;
        set $core_upstream http://core:8000;
        proxy_pass $core_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # ── The single-page app ────────────────────────────────────────────────

    # Hashed filenames, so these can never go stale.
    location /assets/ {
        include /etc/nginx/gate/gate_check.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html must NOT be cached: a phone holding yesterday's shell while
    # /assets serves today's chunks is the classic "the feature isn't there".
    location / {
        include /etc/nginx/gate/gate_check.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
