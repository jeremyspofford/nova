{
  "name": "Nova",
  "short_name": "Nova",
  "description": "Your hub for chat, delegated work, coding and always-on agents.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e0f12",
  "theme_color": "#0e0f12",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "protocol_handlers": [{ "protocol": "web+nova", "url": "/open?url=%s" }]
}
