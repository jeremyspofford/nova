{
  "name": "nova",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Nova, a personal agent. Plain files are the source of truth.",
  "type": "module",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev:follow": "node scripts/dev-follow.js",
    "dev": "NOVA_DEV=1 node --watch-path=src --watch-path=system --watch-path=templates --watch-path=ui/js src/server.js",
    "test": "sh scripts/test.sh 'tests/*.test.js' 'tests/core/*.test.ts' 'tests/acceptance/*.test.ts' 'tests/supervisor/*.test.ts' 'tests/chaos/*.test.ts' 'tests/ingest/*.test.ts' 'tests/ingest/*.test.js'",
    "lint:tokens": "node scripts/lint-tokens.js",
    "check:themes": "node scripts/check-themes.js",
    "changelog": "node scripts/changelog.js",
    "check": "npm run lint:tokens && npm run check:themes && npm run typecheck && npm test",
    "shots": "node scripts/shots.js",
    "typecheck": "tsc -p tsconfig.json",
    "test:ui": "sh scripts/tripwire.sh node --test --test-concurrency=1 --test-force-exit --test-timeout=900000 'tests/ui/*.test.ts'",
    "test:ui:shard": "f=$(node scripts/ui-shard.js \"${NOVA_UI_SHARD:?set NOVA_UI_SHARD, e.g. 1/4}\") && sh scripts/tripwire.sh node --test --test-concurrency=1 --test-force-exit --test-timeout=900000 $f",
    "ui-test": "scripts/ui-test.sh",
    "ui:axe": "node tests/ui/axe-advisory.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "jsqr": "1.4.0",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2"
  }
}
