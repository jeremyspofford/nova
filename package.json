{
  "name": "nova",
  "private": true,
  "version": "0.0.0",
  "description": "Nova: a hub-and-spoke, multi-device AI system.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/compute",
    "services/relay"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test --concurrency=4",
    "test:e2e": "playwright test",
    "test:rust": "node scripts/cargo.mjs test",
    "build": "turbo run build",
    "check:spec": "node scripts/check-spec.mjs",
    "notices": "node scripts/notices.mjs",
    "dev": "turbo run dev --filter=@nova/hub..."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@12.0.2"
}
