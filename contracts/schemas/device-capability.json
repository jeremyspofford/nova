{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/device-capability.json",
  "title": "DeviceCapability",
  "type": "object",
  "required": ["schemaVersion", "deviceId", "roles", "hardware", "os"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "deviceId": { "type": "string" },
    "name": { "type": "string" },
    "roles": {
      "type": "array",
      "items": { "enum": ["hub", "compute", "client", "wake-helper"] },
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "items": {
        "enum": [
          "management",
          "compute",
          "browser",
          "screen",
          "storage",
          "capture",
          "firmware",
          "local-runtime"
        ]
      },
      "description": "Installed modules (docs/23 §4); capture is the networkless ambient capture helper (FR-228); local-runtime serves this device's local models to local clients (FR-128, M7); since M7.5 novad lists browser (the local browser fallback and the extension bridge host, FR-209, FR-096) and firmware (listed only when a BIOS backend works on this machine, FR-146).",
      "uniqueItems": true
    },
    "hardware": {
      "type": "object",
      "required": ["arch"],
      "additionalProperties": false,
      "properties": {
        "arch": { "type": "string" },
        "cores": { "type": "integer", "minimum": 1 },
        "ramBytes": { "type": "integer", "minimum": 0 },
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "mount": { "type": "string" }, "freeBytes": { "type": "integer" } }
          }
        },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vendor": { "type": "string" },
              "name": { "type": "string" },
              "vramBytes": { "type": "integer" }
            }
          }
        },
        "nic": {
          "type": "object",
          "properties": {
            "wol": { "type": "boolean" },
            "macs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "firmware": {
          "type": "object",
          "properties": {
            "type": { "enum": ["bios", "uefi", "unknown"] },
            "vendor": { "type": "string" },
            "oob": {
              "type": "object",
              "properties": {
                "amt": { "type": "boolean" },
                "ipmi": { "type": "boolean" },
                "redfish": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "os": {
      "type": "object",
      "properties": {
        "family": { "type": "string" },
        "version": { "type": "string" },
        "init": { "type": "string" },
        "packageManager": { "type": "string" },
        "sandbox": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "computeBackends": { "type": "array", "items": { "type": "string" } },
        "listeningPorts": { "type": "array", "items": { "type": "integer" } },
        "modelsPresent": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "format": { "type": "string" },
              "sizeBytes": { "type": "integer" }
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "storagePaths": { "type": "array", "items": { "type": "string" } },
        "cacheQuotaBytes": { "type": "integer" }
      }
    },
    "computePolicy": {
      "type": "object",
      "properties": {
        "gpuSharing": { "enum": ["exclusive", "shared"] },
        "vramReserveBytes": { "type": "integer" },
        "maxConcurrentJobs": { "type": "integer", "minimum": 0 },
        "maxJobDurationSec": { "type": "integer", "minimum": 1 }
      }
    },
    "peripherals": {
      "type": "object",
      "properties": {
        "screens": { "type": "integer" },
        "camera": { "type": "boolean" },
        "mic": { "type": "boolean" },
        "speakers": { "type": "boolean" },
        "browser": { "type": "boolean" }
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "fsScopes": { "type": "array", "items": { "type": "string" } },
        "admin": { "type": "boolean" },
        "network": { "type": "string" }
      }
    },
    "power": {
      "type": "object",
      "properties": {
        "ac": { "type": "boolean" },
        "alwaysOn": { "type": "boolean" },
        "wakeable": { "type": "boolean" },
        "policy": { "type": "string" },
        "thermalLimitC": { "type": "integer" }
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "retentionDays": { "type": "integer" },
        "telemetryAllowed": { "type": "boolean" },
        "updateChannel": { "enum": ["stable", "beta", "nightly"] }
      }
    },
    "locale": {
      "type": "object",
      "properties": { "timezone": { "type": "string" }, "locale": { "type": "string" } }
    },
    "scheduling": {
      "type": "object",
      "properties": {
        "quietHours": { "type": "array", "items": { "type": "string" } },
        "energyPriceTier": { "type": "string" },
        "routingWeight": { "type": "number" }
      }
    },
    "limits": {
      "type": "object",
      "properties": { "maxEgressMbps": { "type": "number" } }
    }
  }
}
