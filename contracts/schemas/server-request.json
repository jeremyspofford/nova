{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/server-request.json",
  "title": "ServerRequest",
  "description": "A question the Hub asks connected clients over their stream (FR-188, ADR-072). Each request has one id, a timeout and exactly one resolution; any authorized client may answer, the first valid answer wins, and other clients receive request.resolved. Unanswered requests fall back to notifications.",
  "type": "object",
  "required": ["id", "kind", "status", "payload", "createdAt", "expiresAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "kind": {
      "enum": ["approval", "user_input", "elicitation", "client_tool", "credential_refresh"]
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threadId": { "type": "string" },
        "turnId": { "type": "string" },
        "runId": { "type": "string" },
        "agentId": { "type": "string" },
        "callId": { "type": "string" },
        "approvalId": { "type": "string" }
      }
    },
    "targetDeviceId": {
      "type": "string",
      "description": "Absent = any authorized client. client_tool requests may name one device."
    },
    "status": { "enum": ["pending", "resolved", "expired"] },
    "payload": { "type": "object" },
    "resolution": { "$ref": "#/$defs/resolution" },
    "createdAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "approval" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/approvalPayload" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "user_input" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/userInputPayload" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "elicitation" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/elicitationPayload" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "client_tool" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/clientToolPayload" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "credential_refresh" } } },
      "then": { "properties": { "payload": { "$ref": "#/$defs/credentialRefreshPayload" } } }
    },
    {
      "if": { "properties": { "status": { "const": "resolved" } } },
      "then": { "required": ["resolution"] }
    }
  ],
  "$defs": {
    "approvalPayload": {
      "type": "object",
      "required": ["approvalId", "action", "options"],
      "additionalProperties": false,
      "properties": {
        "approvalId": { "type": "string" },
        "action": { "type": "string", "maxLength": 500 },
        "reason": { "type": "string", "maxLength": 2000 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "tier": { "enum": ["handoff_required", "confirm_at_action", "pre_approvable"] },
        "review": { "$ref": "auto-review-verdict.json" },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "allow_once",
              "allow_session",
              "allow_always",
              "deny_continue",
              "deny_stop",
              "handoff"
            ]
          },
          "description": "Decisions this client may offer; confirm_at_action omits session and always, handoff_required offers only handoff and deny."
        },
        "alwaysScopes": {
          "type": "array",
          "items": { "enum": ["tool", "prefix_rule", "host"] },
          "uniqueItems": true
        },
        "nativeClientOnly": {
          "type": "boolean",
          "description": "true for handoff_required and confirm_at_action: never answerable from a channel."
        }
      }
    },
    "userInputPayload": {
      "type": "object",
      "required": ["question"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "maxLength": 4000 },
        "choices": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 },
          "maxItems": 20
        },
        "allowFreeText": { "type": "boolean", "default": true },
        "multiline": {
          "type": "boolean",
          "description": "The answer is long-form text: clients show a multi-line field."
        }
      }
    },
    "elicitationPayload": {
      "type": "object",
      "required": ["serverId", "message", "requestedSchema"],
      "additionalProperties": false,
      "properties": {
        "serverId": { "type": "string" },
        "message": { "type": "string", "maxLength": 4000 },
        "requestedSchema": {
          "type": "object",
          "description": "Flat JSON Schema of primitive fields, per the MCP elicitation spec."
        }
      }
    },
    "clientToolPayload": {
      "type": "object",
      "required": ["tool", "args"],
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "args": { "type": "object" }
      }
    },
    "credentialRefreshPayload": {
      "type": "object",
      "required": ["targetKind", "targetId"],
      "additionalProperties": false,
      "properties": {
        "targetKind": { "enum": ["provider_account", "connector", "mcp_server"] },
        "targetId": { "type": "string" },
        "reason": { "type": "string", "maxLength": 500 }
      }
    },
    "resolution": {
      "type": "object",
      "required": ["result", "resolvedAt"],
      "additionalProperties": false,
      "properties": {
        "result": {
          "description": "approval: approval-decision.json; user_input: {text|choice}; elicitation: {action: accept|decline|cancel, content?}; client_tool: {ok, output|error}; credential_refresh: {refreshed: boolean}.",
          "type": "object"
        },
        "resolvedBy": { "type": "string", "pattern": "^(user|hook:[^\\s]+)$" },
        "deviceId": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
