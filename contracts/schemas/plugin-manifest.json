{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/plugin-manifest.json",
  "title": "PluginManifest",
  "description": "Plugin .nova-plugin/plugin.json (FR-045, docs/08 §3.1). Components: skills, commands (converted to skills at install, ADR-067), sub-agent roles, hooks (installed untrusted, FR-197), MCP servers, declared browser extensions and MCP Apps UI (FR-198, ADR-066). ${pluginRoot} expands to the installed plugin folder. Declared permissions are enforced, not trusted.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "permissions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "name": { "type": "string", "maxLength": 100 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "maxLength": 500 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
    },
    "license": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "nova": { "type": "string" } }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": { "type": "array", "items": { "type": "string" } },
        "fs": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "tools": {
          "type": "object",
          "description": "Per-tool action class and default, keyed by canonical tool name (FR-045, FR-048).",
          "additionalProperties": {
            "type": "object",
            "required": ["action"],
            "additionalProperties": false,
            "properties": {
              "action": { "$ref": "#/$defs/actionClass" },
              "default": { "$ref": "#/$defs/approvalDefault" }
            }
          }
        },
        "actionDefaults": {
          "type": "object",
          "description": "Defaults per action class; per-tool entries override them.",
          "propertyNames": { "$ref": "#/$defs/actionClass" },
          "additionalProperties": { "$ref": "#/$defs/approvalDefault" }
        },
        "hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "answersAsks": {
              "type": "boolean",
              "default": false,
              "description": "The plugin's hooks may answer an ask from a user rule or a per-tool default; shown in the permission preview."
            }
          }
        },
        "browserExtensions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ids from browserExtensions this plugin asks to install."
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "description": "CSP domain lists for MCP Apps resources, intersected with network permissions.",
          "properties": {
            "connectDomains": { "type": "array", "items": { "type": "string" } },
            "resourceDomains": { "type": "array", "items": { "type": "string" } },
            "frameDomains": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Skill folders containing SKILL.md, registered as skill:<pluginId>:<name>."
    },
    "commands": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Markdown command files, converted to skills at install (the body becomes SKILL.md)."
    },
    "agents": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Sub-agent role files (front-matter name, description, tools, optional model_hint); roles named <pluginId>:<role>."
    },
    "hooks": {
      "description": "Path to a hooks file, or inline hooks (hook-config.json). Hooks install in needs_trust state.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "$ref": "hook-config.json#/$defs/hook" } }
      ]
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": { "$ref": "mcp-config.json#/$defs/server" }
    },
    "browserExtensions": {
      "type": "array",
      "description": "Declared, never installed silently: each needs consent naming the browser profile (FR-096).",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "path": { "type": "string" },
          "browsers": {
            "type": "array",
            "items": { "enum": ["chromium", "firefox", "webkit"] },
            "uniqueItems": true
          },
          "hosts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Host permissions requested; an all-sites pattern is flagged as elevated risk."
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "description": "MCP Apps entry points; resources are ui:// HTML resources served by the plugin's MCP servers.",
      "properties": {
        "entryPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "resource"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["global", "thread", "file"] },
              "resource": { "type": "string", "pattern": "^ui://" },
              "title": { "type": "string", "maxLength": 100 },
              "extensions": {
                "type": "array",
                "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" },
                "description": "file entry points only."
              }
            },
            "if": { "properties": { "kind": { "const": "file" } } },
            "then": { "required": ["extensions"] },
            "else": { "not": { "required": ["extensions"] } }
          }
        }
      }
    }
  },
  "$defs": {
    "actionClass": { "enum": ["read", "write", "send", "delete", "execute"] },
    "approvalDefault": { "enum": ["allow", "ask", "deny"] }
  }
}
