{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/smart-home-entity.json",
  "title": "SmartHomeEntity",
  "type": "object",
  "required": ["id", "accountId", "integration", "externalId", "type"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "accountId": { "type": "string" },
    "integration": { "enum": ["ha", "mqtt", "matter", "vendor"] },
    "externalId": { "type": "string" },
    "type": {
      "enum": [
        "light",
        "switch",
        "sensor",
        "binary_sensor",
        "climate",
        "lock",
        "cover",
        "media_player",
        "camera",
        "vacuum",
        "fan",
        "number",
        "select",
        "button"
      ]
    },
    "areaId": { "type": "string" },
    "name": { "type": "string" },
    "state": { "type": ["string", "number", "boolean", "null"] },
    "attributes": { "type": "object" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
