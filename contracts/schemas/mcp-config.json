{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/mcp-config.json",
  "title": "McpConfig",
  "$defs": {
    "server": {
      "type": "object",
      "required": ["transport"],
      "additionalProperties": false,
      "properties": {
        "transport": {
          "enum": ["stdio", "sse", "http"],
          "description": "http = streamable HTTP (FR-042)."
        },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Values may be secret references (secret://...)."
        },
        "url": { "type": "string", "format": "uri" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "HTTP headers for sse/http; secret values are secret:// references."
        },
        "auth": {
          "type": "string",
          "description": "secret:// reference to an API key or bearer token."
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "description": "OAuth 2 with PKCE (FR-047). Use a client metadata document or dynamic client registration when the server offers them.",
          "properties": {
            "clientMetadataUrl": { "type": "string", "format": "uri" },
            "dynamicRegistration": { "type": "boolean", "default": false },
            "scopes": { "type": "array", "items": { "type": "string" } }
          },
          "not": {
            "required": ["clientMetadataUrl", "dynamicRegistration"],
            "properties": { "dynamicRegistration": { "const": true } }
          }
        },
        "deviceId": {
          "type": "string",
          "description": "Run this stdio server on a device and reach it through novad (FR-210)."
        },
        "startupTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000,
          "default": 30000
        },
        "toolTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "default": 60000
        },
        "enabledTools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "If present, only these tools are exposed."
        },
        "disabledTools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Applied after enabledTools."
        },
        "readOnlyTools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "maxItems": 500,
          "uniqueItems": true,
          "description": "Tools the owner declared read-only in Settings, matched like enabledTools; their descriptors carry userReadOnly (FR-082, FR-189, docs/08 §1). Only the owner sets it: ignored in plugin manifests, and never taken from the server's hints."
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "A session that depends on this server fails to start when the server does not start."
        },
        "defaultApproval": {
          "enum": ["allow", "ask", "deny"],
          "default": "ask",
          "description": "Per-tool default for the policy engine; never overrides built-in safety (FR-099)."
        },
        "deferred": {
          "type": "boolean",
          "description": "Force tools behind tool.search (true) or always load them (false); absent = automatic (FR-196)."
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "network": { "type": "array", "items": { "type": "string" } },
            "fs": { "enum": ["none", "read", "project"] }
          }
        },
        "enabled": { "type": "boolean", "default": true }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "stdio" } } },
          "then": { "required": ["command"] }
        },
        {
          "if": { "properties": { "transport": { "enum": ["sse", "http"] } } },
          "then": { "required": ["url"], "not": { "required": ["deviceId"] } }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "servers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/server" } }
  }
}
