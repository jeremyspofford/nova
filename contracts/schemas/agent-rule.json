{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/agent-rule.json",
  "title": "AgentRule",
  "description": "An always-on agent's custom rule (FR-084, docs/12 §3) as stored in agent_rule and returned as AgentRuleView; mirrors the Zod schemas in packages/shared/src/m6/agents.ts. The rule joins the user layer of the policy set for every thread of the agent (never the managed layer): act allows, act_on_request allows only for the user's own untainted instruction and otherwise asks, ask asks, handoff hands off. Lists inside one match dimension are alternatives; the dimensions combine with AND. Built-in safety and the confirmation tiers (FR-189) still apply.",
  "type": "object",
  "required": [
    "id",
    "agentId",
    "description",
    "effect",
    "match",
    "command",
    "priority",
    "enabled",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "agentId": { "type": "string" },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "effect": { "enum": ["act", "act_on_request", "ask", "handoff"] },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "description": "A rule names hosts or channels, not both.",
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:*-]{1,200}$" },
          "description": "Tool names or globs."
        },
        "hosts": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "pattern": "^(\\*\\.)?[A-Za-z0-9.-]{1,253}$" },
          "description": "A host, optionally starting with *."
        },
        "actions": {
          "type": "array",
          "maxItems": 5,
          "items": { "enum": ["read", "write", "send", "delete", "execute"] },
          "description": "Action classes: read and write map to read-only or not; send, delete and execute to the effect classes external_communication, data_delete and exec."
        },
        "effects": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": [
              "external_communication",
              "purchase",
              "account_change",
              "credential_change",
              "data_delete",
              "file_write",
              "exec",
              "network"
            ]
          }
        },
        "channels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["inapp", "slack", "teams", "email", "webhook", "telegram"] },
              "conversation": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          },
          "description": "Matched as the account resource <kind>:<conversation or *>."
        }
      }
    },
    "command": {
      "description": "An optional command prefix rule (FR-191, command-rule.json): its examples must match as stated, and it may only act or ask.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["pattern", "matchExamples", "notMatchExamples"],
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "oneOf": [
                  { "type": "string", "minLength": 1, "maxLength": 200 },
                  {
                    "type": "array",
                    "minItems": 2,
                    "items": { "type": "string", "minLength": 1, "maxLength": 200 }
                  }
                ]
              }
            },
            "matchExamples": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            },
            "notMatchExamples": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
            },
            "justification": { "type": "string", "maxLength": 500 },
            "tools": {
              "type": "array",
              "maxItems": 2,
              "items": { "enum": ["exec.run", "exec.write"] },
              "description": "Default exec.run."
            }
          }
        }
      ]
    },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 100 },
    "enabled": { "type": "boolean", "default": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "command": { "type": "object" } },
        "required": ["command"]
      },
      "then": { "properties": { "effect": { "enum": ["act", "ask"] } } }
    },
    {
      "not": {
        "properties": {
          "match": {
            "properties": { "hosts": { "minItems": 1 }, "channels": { "minItems": 1 } },
            "required": ["hosts", "channels"]
          }
        },
        "required": ["match"]
      }
    }
  ]
}
