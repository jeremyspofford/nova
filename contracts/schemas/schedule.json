{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/schedule.json",
  "title": "Schedule",
  "description": "Recurring task, agent schedule or self-set wake (FR-055, FR-059, FR-206, ADR-079). A create carries when; an update carries id.",
  "type": "object",
  "required": ["instructions", "timezone", "deliveryTargets"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["run", "agent"] },
        "agentId": { "type": "string" }
      }
    },
    "when": {
      "oneOf": [
        {
          "type": "object",
          "required": ["cron"],
          "additionalProperties": false,
          "properties": { "cron": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["rrule"],
          "additionalProperties": false,
          "properties": {
            "rrule": {
              "type": "string",
              "pattern": "^(RRULE:)?FREQ=",
              "description": "RFC 5545 recurrence rule; DTSTART is startsAt, evaluated in timezone."
            }
          }
        },
        {
          "type": "object",
          "required": ["intervalSeconds"],
          "additionalProperties": false,
          "properties": { "intervalSeconds": { "type": "integer", "minimum": 60 } }
        },
        {
          "type": "object",
          "required": ["at"],
          "additionalProperties": false,
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time",
              "description": "One-shot fire, used by self-set wakes."
            }
          }
        }
      ]
    },
    "timezone": { "type": "string", "description": "IANA timezone, e.g. America/Los_Angeles" },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" },
    "instructions": { "type": "string", "maxLength": 8000 },
    "notifyCondition": { "type": "string", "maxLength": 1000 },
    "deliveryTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["inapp", "os", "slack", "teams", "email", "webhook"] },
          "ref": { "type": "string" }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "description": "Declared output that must be verified before the job counts as succeeded (FR-187).",
      "properties": {
        "kind": { "enum": ["artifact", "message", "file"] },
        "ref": { "type": "string", "description": "Artifact title, delivery target or file path." }
      }
    },
    "catchUp": {
      "type": "object",
      "additionalProperties": false,
      "description": "Missed fires collapse into one catch-up run told the window it covers (ADR-079).",
      "properties": {
        "policy": { "enum": ["once", "skip"], "default": "once" },
        "lookbackSeconds": { "type": "integer", "minimum": 0, "default": 604800 }
      }
    },
    "origin": {
      "enum": ["user", "agent", "agent_self"],
      "default": "user",
      "description": "agent: created by an agent with schedule.create (FR-059); agent_self: a wake set with schedule.wake (FR-206)."
    },
    "wakeReason": { "type": "string", "maxLength": 500 },
    "enabled": { "type": "boolean", "default": true }
  },
  "anyOf": [{ "required": ["when"] }, { "required": ["id"] }],
  "allOf": [
    {
      "if": { "properties": { "origin": { "const": "agent_self" } }, "required": ["origin"] },
      "then": {
        "required": ["target", "wakeReason"],
        "properties": {
          "target": {
            "properties": { "kind": { "const": "agent" } },
            "required": ["kind", "agentId"]
          },
          "when": { "required": ["at"] }
        }
      }
    },
    {
      "if": {
        "properties": { "target": { "properties": { "kind": { "const": "agent" } } } },
        "required": ["target"]
      },
      "then": { "properties": { "target": { "required": ["agentId"] } } }
    }
  ]
}
