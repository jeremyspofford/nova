{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/tool-descriptor.json",
  "title": "ToolDescriptor",
  "type": "object",
  "required": ["name", "title", "description", "source", "inputSchema"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^(mcp:[a-z0-9-]+\\.[A-Za-z0-9_]+|plugin:[a-z0-9.-]+\\.[A-Za-z0-9_]+|[a-z]+\\.[a-z][A-Za-z0-9_]*)$" },
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "source": { "enum": ["builtin", "mcp", "plugin", "computer"] },
    "serverId": { "type": "string" },
    "pluginId": { "type": "string" },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnly": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "requiresNetwork": { "type": "boolean" },
        "requiresUser": { "type": "boolean" },
        "costClass": { "enum": ["free", "metered"] }
      }
    },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000, "default": 60000 }
  }
}
