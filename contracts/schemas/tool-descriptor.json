{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/tool-descriptor.json",
  "title": "ToolDescriptor",
  "description": "Registered tool metadata (docs/08 §1). Built-in names are domain.action (for example tool.search, context.remaining, context.fresh, exec.write, goal.update, schedule.wake, ambient.activity_summary) plus a few single-word tools such as ask_user.",
  "type": "object",
  "required": ["name", "title", "description", "source", "inputSchema"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^(mcp:[a-z0-9-]+\\.[A-Za-z0-9_.-]+|plugin:[a-z0-9.-]+\\.[A-Za-z0-9_]+|page:[a-z0-9.-]+\\.[A-Za-z0-9_]+|[a-z]+(\\.[a-z][A-Za-z0-9_]*)+|[a-z]+(_[a-z]+)+)$"
    },
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "source": { "enum": ["builtin", "mcp", "plugin", "computer", "browser", "page", "device"] },
    "serverId": { "type": "string" },
    "pluginId": { "type": "string" },
    "deviceId": {
      "type": "string",
      "description": "source device: a device-local MCP tool reached through novad (FR-210)."
    },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "loading": {
      "enum": ["always", "deferrable"],
      "description": "Whether the tool may be held behind tool.search when the catalog is over budget (FR-196). Absent: always for built-ins, deferrable for MCP and plugin tools."
    },
    "deferred": {
      "type": "boolean",
      "default": false,
      "description": "In a tool listing for a turn: true while the tool is held behind tool.search and not in the model's tool list. Tools named in an @-mention or an active skill's allowed_tools are never deferred."
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "resourceUri": { "type": "string", "pattern": "^ui://" } },
      "description": "MCP Apps resource that renders this tool (FR-198)."
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnly": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "requiresNetwork": { "type": "boolean" },
        "requiresUser": { "type": "boolean" },
        "costClass": { "enum": ["free", "metered"] },
        "action": {
          "enum": ["read", "write", "send", "delete", "execute"],
          "description": "Per-action permission class (FR-045)."
        }
      }
    },
    "effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "external_communication",
          "purchase",
          "account_change",
          "credential_change",
          "data_delete",
          "file_write",
          "exec",
          "network",
          "install",
          "security_bypass",
          "captcha",
          "policy_change",
          "secret_access"
        ]
      },
      "description": "What the call does in the world; drives the built-in confirmation tiers (FR-189, ADR-062). Declared by built-ins; for MCP and plugin tools set from the manifest and never from server hints alone."
    },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000, "default": 60000 }
  },
  "if": { "properties": { "source": { "const": "builtin" } }, "required": ["source"] },
  "then": { "properties": { "loading": { "const": "always" }, "deferred": { "const": false } } }
}
