{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/goal.json",
  "title": "Goal",
  "description": "A budgeted objective held by a run or an agent (FR-181, FR-182, ADR-058). Only the system sets usage_limited and budget_limited; the agent sets blocked only after the same blocker recurs on 3 consecutive goal turns.",
  "type": "object",
  "required": ["id", "objective", "status", "statusSetBy"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "runId": { "type": "string" },
    "agentId": { "type": "string" },
    "threadId": {
      "type": "string",
      "description": "Thread where continuation turns (trigger goal) run."
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "status": {
      "enum": ["active", "paused", "blocked", "usage_limited", "budget_limited", "complete"]
    },
    "statusSetBy": { "enum": ["user", "agent", "system"] },
    "statusReason": { "type": "string", "maxLength": 2000 },
    "progressNote": { "type": "string", "maxLength": 4000 },
    "completionSummary": { "type": "string", "maxLength": 8000 },
    "budgets": {
      "$ref": "#/$defs/amounts",
      "description": "Optional caps; absent fields fall back to the run or agent budgets."
    },
    "usage": { "$ref": "#/$defs/amounts" },
    "blocker": {
      "type": "object",
      "required": ["key", "count"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Consecutive goal turns reporting this key; reset on resume."
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    { "required": ["runId"], "not": { "required": ["agentId"] } },
    { "required": ["agentId"], "not": { "required": ["runId"] } }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["usage_limited", "budget_limited"] } },
        "required": ["status"]
      },
      "then": { "properties": { "statusSetBy": { "const": "system" } } }
    },
    {
      "if": {
        "properties": { "status": { "const": "blocked" }, "statusSetBy": { "const": "agent" } },
        "required": ["status", "statusSetBy"]
      },
      "then": {
        "required": ["blocker"],
        "properties": { "blocker": { "properties": { "count": { "minimum": 3 } } } }
      }
    }
  ],
  "$defs": {
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "timeSeconds": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
