{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arialabs.ai/schemas/policy-rule.json",
  "title": "PolicyRule",
  "description": "Tool and resource rule evaluated by the policy engine (FR-099, FR-084). Shell commands are matched by command-rule.json (FR-191); sandbox limits come from permission-profile.json (FR-190). No rule can override built-in safety or protected paths.",
  "type": "object",
  "required": ["id", "scope", "match", "effect", "enabled"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string", "maxLength": 200 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 100 },
    "enabled": { "type": "boolean", "default": true },
    "source": { "enum": ["user", "managed", "plugin"], "default": "user" },
    "scope": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "global",
            "project",
            "thread",
            "run",
            "session",
            "agent",
            "tool",
            "plugin",
            "site"
          ]
        },
        "ref": { "type": "string" }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "array", "items": { "type": "string" } },
        "source": {
          "type": "array",
          "items": { "enum": ["builtin", "mcp", "plugin", "computer", "browser", "page", "device"] }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["path", "host", "account"] },
            "pattern": { "type": "string" },
            "host": { "type": "string" },
            "pathPrefix": { "type": "string" }
          }
        },
        "effect": {
          "type": "array",
          "items": {
            "enum": [
              "external_communication",
              "purchase",
              "account_change",
              "credential_change",
              "data_delete",
              "file_write",
              "exec",
              "network"
            ]
          }
        },
        "readOnly": { "type": "boolean" }
      }
    },
    "effect": { "enum": ["allow", "ask", "handoff", "deny"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
