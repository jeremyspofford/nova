      "type": "choices",
      "describe": "Radio questions he answers, then one button sends submit.message as his own chat message with each {id} replaced by the chosen option label; questions 1-6 {id, label, options [{value, label}] 2-8, default?}; submit.message never starts with \"/\".",
      "example": {
        "type": "choices",
        "questions": [
          {
            "id": "goal",
            "label": "What should it produce?",
            "options": [
              {
                "value": "personal",
                "label": "Tools for myself"
              },
              {
                "value": "both",
                "label": "Both"
              }
