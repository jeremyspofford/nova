{
  "id": "companion-light",
  "version": "1.0.5",
  "kind": "design-system",
  "name": "Companion Light",
  "description": "Warm cream, a soft coral accent, the teal orb and a serif voice.",
  "capabilities": ["design-system"],
  "permissions": [],
  "secrets": [],
  "config_schema": {},
  "setup_flow": null,
  "health_check": { "kind": "none" },
  "nova_compat": ">=0.1.0 <1.0.0",
  "on_remove": { "delete": [], "keep": [], "export": [] },
  "tokens": {
    "bg/base": "#f8f1e7",
    "bg/raised": "#fcf7f0",
    "bg/overlay": "#fffaf3",
    "surface/card": "#fffaf4",
    "surface/card-hover": "#f6ece0",
    "text/primary": "#2b2420",
    "text/secondary": "#665a50",
    "text/faint": "#8a7b6f",
    "border/subtle": "#eadfd2",
    "border/strong": "#918478",
    "accent/primary": "#ad5638",
    "accent/secondary": "#2f8f84",
    "status/ok": "#3f7d4a",
    "status/working": "#2f8f84",
    "status/waiting": "#665a50",
    "status/attention": "#a5650f",
    "status/error": "#b23a2e",
    "orb/core": "#3fb8a6",
    "orb/glow": "rgba(63, 184, 166, 0.35)",
    "orb/listening": "#66cdbd",
    "orb/attention": "#e0a24a",
    "font/display": "ui-serif, \"New York\", \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
    "font/body": "-apple-system, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif",
    "font/mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "type/h1": "34px",
    "type/h2": "24px",
    "type/h3": "18px",
    "type/body": "16px",
    "type/small": "14px",
    "type/caption": "12px",
    "type/weight-regular": "400",
    "type/weight-strong": "600",
    "type/line-tight": "1.2",
    "type/line-body": "1.55",
    "space/1": "4px",
    "space/2": "8px",
    "space/3": "12px",
    "space/4": "16px",
    "space/5": "24px",
    "space/6": "36px",
    "space/7": "56px",
    "space/8": "72px",
    "radius/card": "20px",
    "radius/pill": "999px",
    "radius/input": "14px",
    "shadow/card": "0 1px 2px rgba(80, 55, 30, 0.05), 0 8px 24px rgba(80, 55, 30, 0.08)",
    "shadow/raised": "0 2px 6px rgba(80, 55, 30, 0.06), 0 16px 40px rgba(80, 55, 30, 0.14)",
    "blur/glass": "0px",
    "motion/breathe": "6500ms",
    "motion/pulse": "1800ms",
    "motion/transition": "260ms",
    "motion/duration-fast": "180ms",
    "motion/duration-slow": "300ms",
    "motion/ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "layout/rail-width": "84px",
    "layout/content-max": "680px",
    "layout/card-gap": "16px"
  },
  "modes": {},
  "reduced_motion": {},
  "orb_states": {
    "idle": { "color": "orb/core", "motion": "breathe", "light": "soft", "mark": "none", "reduced": { "light": "soft", "mark": "none" } },
    "listening": { "color": "orb/listening", "motion": "swirl", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "none" } },
    "working": { "color": "orb/core", "motion": "pulse", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "dashed" } },
    "speaking": { "color": "orb/core", "motion": "ripple", "light": "bright", "mark": "none", "reduced": { "light": "bright", "mark": "none" } },
    "needs-you": { "color": "orb/attention", "motion": "beckon", "light": "bright", "mark": "dashed", "reduced": { "light": "bright", "mark": "dashed" } },
    "stopped": { "color": "status/error", "motion": "alarm", "light": "stark", "mark": "ring", "reduced": { "light": "stark", "mark": "ring" } },
    "offline": { "color": "orb/core", "motion": "still", "light": "dim", "mark": "none", "reduced": { "light": "dim", "mark": "none" } }
  },
  "components": {
    "app": { "background": "bg/base" },
    "orb": { "core": "orb/core", "glow": "orb/glow", "listening": "orb/listening", "needs-you": "orb/attention", "stopped": "status/error" },
    "brief-card": { "background": "surface/card", "border": "border/subtle", "radius": "radius/card", "title": "font/display" },
    "handling-card": { "background": "surface/card", "border": "border/subtle", "radius": "radius/card", "title": "font/display" },
    "chat-bubble": { "nova": "surface/card", "person": "surface/card-hover" }
  },
  "content_rules": {},
  "extras": [],
  "preview": [],
  "ios_status_bar": "default"
}
