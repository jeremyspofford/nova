{
  "id": "paper",
  "version": "1.0.4",
  "kind": "design-system",
  "name": "Paper",
  "description": "Warm paper, ink, and a serif voice.",
  "capabilities": [
    "design-system"
  ],
  "permissions": [],
  "secrets": [],
  "config_schema": {},
  "setup_flow": null,
  "health_check": {
    "kind": "none"
  },
  "nova_compat": ">=0.1.0 <1.0.0",
  "on_remove": {
    "delete": [],
    "keep": [],
    "export": []
  },
  "tokens": {
    "bg/base": "#faf7f2",
    "bg/raised": "#ffffff",
    "bg/overlay": "#ffffff",
    "surface/card": "#ffffff",
    "surface/card-hover": "#f3eee6",
    "text/primary": "#23201b",
    "text/secondary": "#726c63",
    "text/faint": "#91887b",
    "border/subtle": "#e8e1d5",
    "border/strong": "#91887b",
    "accent/primary": "#c4502b",
    "accent/secondary": "#4a7a3f",
    "status/ok": "#4a7a3f",
    "status/working": "#c4502b",
    "status/waiting": "#726c63",
    "status/attention": "#a86e14",
    "status/error": "#b3352b",
    "orb/core": "#c4502b",
    "orb/glow": "rgba(196, 80, 43, 0.35)",
    "orb/listening": "#c4502b",
    "orb/attention": "#a86e14",
    "shadow/card": "0 1px 2px rgba(60, 45, 25, 0.05), 0 6px 20px rgba(60, 45, 25, 0.06)",
    "shadow/raised": "0 2px 6px rgba(60, 45, 25, 0.06), 0 16px 40px rgba(60, 45, 25, 0.12)",
    "font/display": "ui-serif, \"New York\", \"Iowan Old Style\", Georgia, \"Times New Roman\", serif",
    "font/body": "-apple-system, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif",
    "font/mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "type/h1": "30px",
    "type/h2": "24px",
    "type/h3": "15px",
    "type/body": "15.5px",
    "type/small": "13px",
    "type/caption": "11px",
    "type/weight-regular": "400",
    "type/weight-strong": "600",
    "type/line-tight": "1.33",
    "type/line-body": "1.55",
    "space/1": "4px",
    "space/2": "8px",
    "space/3": "12px",
    "space/4": "16px",
    "space/5": "24px",
    "space/6": "36px",
    "space/7": "56px",
    "space/8": "64px",
    "radius/card": "10px",
    "radius/pill": "999px",
    "radius/input": "10px",
    "blur/glass": "0px",
    "motion/breathe": "6000ms",
    "motion/pulse": "1600ms",
    "motion/transition": "300ms",
    "motion/duration-fast": "200ms",
    "motion/duration-slow": "300ms",
    "motion/ease": "cubic-bezier(0.4, 0, 0.2, 1)",
    "layout/rail-width": "84px",
    "layout/content-max": "680px",
    "layout/card-gap": "12px"
  },
  "modes": {
    "dark": {
      "bg/base": "#171512",
      "bg/raised": "#1f1c18",
      "bg/overlay": "#26221d",
      "surface/card": "#26221d",
      "surface/card-hover": "#2a2620",
      "text/primary": "#ede7dc",
      "text/secondary": "#a79d8f",
      "text/faint": "#8a8175",
      "border/subtle": "#322d26",
      "border/strong": "#8a8175",
      "accent/primary": "#d9714c",
      "accent/secondary": "#86b574",
      "status/ok": "#86b574",
      "status/working": "#d9714c",
      "status/waiting": "#a79d8f",
      "status/attention": "#d9a04a",
      "status/error": "#e8776b",
      "orb/core": "#d9714c",
      "orb/glow": "rgba(217, 113, 76, 0.35)",
      "orb/listening": "#d9714c",
      "orb/attention": "#d9a04a",
      "shadow/card": "0 1px 2px rgba(0, 0, 0, 0.3), 0 6px 20px rgba(0, 0, 0, 0.25)",
      "shadow/raised": "0 2px 6px rgba(0, 0, 0, 0.3), 0 16px 40px rgba(0, 0, 0, 0.4)"
    }
  },
  "reduced_motion": {},
  "orb_states": {
    "idle": { "color": "orb/core", "motion": "breathe", "light": "soft", "mark": "none", "reduced": { "light": "soft", "mark": "none" } },
    "listening": { "color": "orb/listening", "motion": "swirl", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "none" } },
    "working": { "color": "orb/core", "motion": "pulse", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "dashed" } },
    "speaking": { "color": "orb/core", "motion": "ripple", "light": "bright", "mark": "none", "reduced": { "light": "bright", "mark": "none" } },
    "needs-you": { "color": "orb/attention", "motion": "beckon", "light": "bright", "mark": "dashed", "reduced": { "light": "bright", "mark": "dashed" } },
    "stopped": { "color": "status/error", "motion": "alarm", "light": "stark", "mark": "ring", "reduced": { "light": "stark", "mark": "ring" } },
    "offline": { "color": "orb/core", "motion": "still", "light": "dim", "mark": "none", "reduced": { "light": "dim", "mark": "none" } }
  },
  "components": {
    "orb": {
      "core": "orb/core",
      "glow": "orb/glow",
      "listening": "orb/listening",
      "needs-you": "orb/attention",
      "stopped": "status/error"
    },
    "app": {
      "background": "bg/base"
    }
  },
  "content_rules": {},
  "extras": [],
  "preview": [],
  "ios_status_bar": { "light": "default", "dark": "translucent" }
}
