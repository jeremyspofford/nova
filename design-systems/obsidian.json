{
  "id": "obsidian",
  "version": "1.0.4",
  "kind": "design-system",
  "name": "Obsidian",
  "description": "A quiet control room. Always dark.",
  "capabilities": [
    "design-system"
  ],
  "permissions": [],
  "secrets": [],
  "config_schema": {},
  "setup_flow": null,
  "health_check": {
    "kind": "none"
  },
  "nova_compat": ">=0.1.0 <1.0.0",
  "on_remove": {
    "delete": [],
    "keep": [],
    "export": []
  },
  "tokens": {
    "bg/base": "#0b0c0e",
    "bg/raised": "#131417",
    "bg/overlay": "#1a1b1f",
    "surface/card": "#1a1b1f",
    "surface/card-hover": "#1a1b1f",
    "text/primary": "#e8e9eb",
    "text/secondary": "#9ba0a6",
    "text/faint": "#63676e",
    "border/subtle": "rgba(255, 255, 255, 0.07)",
    "border/strong": "#62666d",
    "accent/primary": "#e8b34b",
    "accent/secondary": "#4cc38a",
    "status/ok": "#4cc38a",
    "status/working": "#e8b34b",
    "status/waiting": "#9ba0a6",
    "status/attention": "#e8b34b",
    "status/error": "#e5534b",
    "orb/core": "#e8b34b",
    "orb/glow": "rgba(232, 179, 75, 0.35)",
    "orb/listening": "#e8b34b",
    "orb/attention": "#e8b34b",
    "shadow/card": "none",
    "shadow/raised": "0 12px 32px rgba(0, 0, 0, 0.5)",
    "font/display": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, monospace",
    "font/body": "\"Inter\", -apple-system, \"Segoe UI\", sans-serif",
    "font/mono": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, monospace",
    "type/h1": "20px",
    "type/h2": "16px",
    "type/h3": "13px",
    "type/body": "14px",
    "type/small": "12px",
    "type/caption": "10.5px",
    "type/weight-regular": "400",
    "type/weight-strong": "600",
    "type/line-tight": "1.38",
    "type/line-body": "1.5",
    "space/1": "4px",
    "space/2": "8px",
    "space/3": "12px",
    "space/4": "16px",
    "space/5": "24px",
    "space/6": "32px",
    "space/7": "48px",
    "space/8": "64px",
    "radius/card": "8px",
    "radius/pill": "999px",
    "radius/input": "8px",
    "blur/glass": "0px",
    "motion/breathe": "6000ms",
    "motion/pulse": "1600ms",
    "motion/transition": "180ms",
    "motion/duration-fast": "150ms",
    "motion/duration-slow": "260ms",
    "motion/ease": "cubic-bezier(0.2, 0, 0, 1)",
    "layout/rail-width": "84px",
    "layout/content-max": "760px",
    "layout/card-gap": "12px"
  },
  "modes": {},
  "reduced_motion": {},
  "orb_states": {
    "idle": { "color": "orb/core", "motion": "breathe", "light": "soft", "mark": "none", "reduced": { "light": "soft", "mark": "none" } },
    "listening": { "color": "orb/listening", "motion": "swirl", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "none" } },
    "working": { "color": "orb/core", "motion": "pulse", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "dashed" } },
    "speaking": { "color": "orb/core", "motion": "ripple", "light": "bright", "mark": "none", "reduced": { "light": "bright", "mark": "none" } },
    "needs-you": { "color": "orb/attention", "motion": "beckon", "light": "bright", "mark": "dashed", "reduced": { "light": "bright", "mark": "dashed" } },
    "stopped": { "color": "status/error", "motion": "alarm", "light": "stark", "mark": "ring", "reduced": { "light": "stark", "mark": "ring" } },
    "offline": { "color": "orb/core", "motion": "still", "light": "dim", "mark": "none", "reduced": { "light": "dim", "mark": "none" } }
  },
  "components": {
    "orb": {
      "core": "orb/core",
      "glow": "orb/glow",
      "listening": "orb/listening",
      "needs-you": "orb/attention",
      "stopped": "status/error"
    },
    "app": {
      "background": "bg/base"
    }
  },
  "content_rules": {},
  "extras": [],
  "preview": [],
  "ios_status_bar": "translucent"
}
