{
  "id": "aurora",
  "version": "1.0.6",
  "kind": "design-system",
  "name": "Aurora",
  "description": "Morning light through frosted glass.",
  "capabilities": [
    "design-system"
  ],
  "permissions": [],
  "secrets": [],
  "config_schema": {},
  "setup_flow": null,
  "health_check": {
    "kind": "none"
  },
  "nova_compat": ">=0.1.0 <1.0.0",
  "on_remove": {
    "delete": [],
    "keep": [],
    "export": []
  },
  "tokens": {
    "bg/base": "#f5f5f7",
    "bg/raised": "rgba(255, 255, 255, 0.72)",
    "bg/overlay": "#ffffff",
    "surface/card": "#ffffff",
    "surface/card-hover": "#ececf1",
    "text/primary": "#1d1d1f",
    "text/secondary": "#6a6a6f",
    "text/faint": "#86868b",
    "border/subtle": "rgba(0, 0, 0, 0.08)",
    "border/strong": "#86868b",
    "accent/primary": "#5856d2",
    "accent/secondary": "#248a3d",
    "status/ok": "#248a3d",
    "status/working": "#5e5ce6",
    "status/waiting": "#6e6e73",
    "status/attention": "#b25000",
    "status/error": "#d70015",
    "orb/core": "#5e5ce6",
    "orb/glow": "rgba(94, 92, 230, 0.35)",
    "orb/listening": "#5e5ce6",
    "orb/attention": "#b25000",
    "shadow/card": "0 1px 2px rgba(0, 0, 0, 0.05), 0 4px 16px rgba(0, 0, 0, 0.05)",
    "shadow/raised": "0 8px 32px rgba(0, 0, 0, 0.12)",
    "font/display": "-apple-system, \"SF Pro Display\", \"Helvetica Neue\", Arial, sans-serif",
    "font/body": "-apple-system, \"SF Pro Text\", \"Helvetica Neue\", Arial, sans-serif",
    "font/mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "type/h1": "28px",
    "type/h2": "22px",
    "type/h3": "17px",
    "type/body": "15px",
    "type/small": "13px",
    "type/caption": "12px",
    "type/weight-regular": "400",
    "type/weight-strong": "600",
    "type/line-tight": "1.29",
    "type/line-body": "1.47",
    "space/1": "4px",
    "space/2": "8px",
    "space/3": "12px",
    "space/4": "16px",
    "space/5": "24px",
    "space/6": "32px",
    "space/7": "48px",
    "space/8": "64px",
    "radius/card": "14px",
    "radius/pill": "999px",
    "radius/input": "12px",
    "blur/glass": "20px",
    "motion/breathe": "6000ms",
    "motion/pulse": "1600ms",
    "motion/transition": "240ms",
    "motion/duration-fast": "160ms",
    "motion/duration-slow": "300ms",
    "motion/ease": "cubic-bezier(0.28, 0.11, 0.21, 1)",
    "layout/rail-width": "84px",
    "layout/content-max": "720px",
    "layout/card-gap": "12px"
  },
  "modes": {
    "dark": {
      "bg/base": "#000000",
      "bg/raised": "rgba(28, 28, 30, 0.72)",
      "bg/overlay": "#2c2c2e",
      "surface/card": "#2c2c2e",
      "surface/card-hover": "#2c2c2e",
      "text/primary": "#f5f5f7",
      "text/secondary": "#a5a5aa",
      "text/faint": "#808085",
      "border/subtle": "rgba(255, 255, 255, 0.12)",
      "border/strong": "#808085",
      "accent/primary": "#8986fe",
      "accent/secondary": "#30d158",
      "status/ok": "#30d158",
      "status/working": "#7d7aff",
      "status/waiting": "#a1a1a6",
      "status/attention": "#ff9f0a",
      "status/error": "#ff6961",
      "orb/core": "#7d7aff",
      "orb/glow": "rgba(125, 122, 255, 0.35)",
      "orb/listening": "#7d7aff",
      "orb/attention": "#ff9f0a",
      "shadow/card": "0 1px 2px rgba(0, 0, 0, 0.4), 0 4px 16px rgba(0, 0, 0, 0.3)",
      "shadow/raised": "0 8px 32px rgba(0, 0, 0, 0.5)"
    }
  },
  "reduced_motion": {},
  "orb_states": {
    "idle": { "color": "orb/core", "motion": "breathe", "light": "soft", "mark": "none", "reduced": { "light": "soft", "mark": "none" } },
    "listening": { "color": "orb/listening", "motion": "swirl", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "none" } },
    "working": { "color": "orb/core", "motion": "pulse", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "dashed" } },
    "speaking": { "color": "orb/core", "motion": "ripple", "light": "bright", "mark": "none", "reduced": { "light": "bright", "mark": "none" } },
    "needs-you": { "color": "orb/attention", "motion": "beckon", "light": "bright", "mark": "dashed", "reduced": { "light": "bright", "mark": "dashed" } },
    "stopped": { "color": "status/error", "motion": "alarm", "light": "stark", "mark": "ring", "reduced": { "light": "stark", "mark": "ring" } },
    "offline": { "color": "orb/core", "motion": "still", "light": "dim", "mark": "none", "reduced": { "light": "dim", "mark": "none" } }
  },
  "components": {
    "orb": {
      "core": "orb/core",
      "glow": "orb/glow",
      "listening": "orb/listening",
      "needs-you": "orb/attention",
      "stopped": "status/error"
    },
    "app": {
      "background": "bg/base"
    }
  },
  "content_rules": {},
  "extras": [],
  "preview": [],
  "ios_status_bar": { "light": "default", "dark": "translucent" }
}
