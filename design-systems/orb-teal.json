{
  "id": "orb-teal",
  "version": "1.0.1",
  "kind": "design-system",
  "name": "Orb Teal",
  "description": "Deep teal light, a luminous orb and frosted glass cards. The default.",
  "capabilities": ["design-system"],
  "permissions": [],
  "secrets": [],
  "config_schema": {},
  "setup_flow": null,
  "health_check": { "kind": "none" },
  "nova_compat": ">=0.1.0 <1.0.0",
  "on_remove": { "delete": [], "keep": [], "export": [] },
  "tokens": {
    "bg/base": "#062a30",
    "bg/raised": "#0b3940",
    "bg/overlay": "#0f424a",
    "surface/card": "rgba(198, 236, 232, 0.12)",
    "surface/card-hover": "rgba(198, 236, 232, 0.18)",
    "text/primary": "#eefaf8",
    "text/secondary": "#b8d6d2",
    "text/faint": "#86aca7",
    "border/subtle": "rgba(198, 236, 232, 0.16)",
    "border/strong": "rgba(202, 237, 234, 0.42)",
    "accent/primary": "#5fe0c0",
    "accent/secondary": "#8fd4f0",
    "status/ok": "#72dca0",
    "status/working": "#5fe0c0",
    "status/waiting": "#b8d6d2",
    "status/attention": "#f2c46b",
    "status/error": "#ff8f85",
    "orb/core": "#5fe8c8",
    "orb/glow": "rgba(95, 232, 200, 0.45)",
    "orb/listening": "#8ff3dc",
    "orb/attention": "#f2b45a",
    "font/display": "-apple-system, \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif",
    "font/body": "-apple-system, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif",
    "font/mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "type/h1": "30px",
    "type/h2": "22px",
    "type/h3": "17px",
    "type/body": "16px",
    "type/small": "14px",
    "type/caption": "12px",
    "type/weight-regular": "400",
    "type/weight-strong": "600",
    "type/line-tight": "1.25",
    "type/line-body": "1.5",
    "space/1": "4px",
    "space/2": "8px",
    "space/3": "12px",
    "space/4": "16px",
    "space/5": "24px",
    "space/6": "32px",
    "space/7": "48px",
    "space/8": "64px",
    "radius/card": "24px",
    "radius/pill": "999px",
    "radius/input": "14px",
    "shadow/card": "0 8px 32px rgba(0, 20, 24, 0.35)",
    "shadow/raised": "0 16px 48px rgba(0, 16, 20, 0.5)",
    "blur/glass": "24px",
    "motion/breathe": "6000ms",
    "motion/pulse": "1800ms",
    "motion/transition": "240ms",
    "motion/duration-fast": "160ms",
    "motion/duration-slow": "420ms",
    "motion/ease": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "layout/rail-width": "76px",
    "layout/content-max": "720px",
    "layout/card-gap": "16px"
  },
  "modes": {},
  "reduced_motion": {},
  "components": {
    "app": { "background": ["bg/base", "bg/raised", "orb/glow"] },
    "orb": { "core": "orb/core", "glow": "orb/glow", "listening": "orb/listening", "attention": "orb/attention", "alert": "status/error" },
    "brief-card": { "background": "surface/card", "border": "border/subtle", "blur": "blur/glass", "radius": "radius/card" },
    "handling-card": { "background": "surface/card", "border": "border/subtle", "blur": "blur/glass", "radius": "radius/card" },
    "chat-bubble": { "nova": "surface/card", "person": "surface/card-hover" }
  },
  "content_rules": {},
  "extras": [],
  "preview": []
}
