{
  "id": "orb-teal",
  "version": "1.1.0",
  "kind": "design-system",
  "name": "Orb Teal",
  "description": "Deep teal light, a luminous orb and frosted glass cards. The default.",
  "capabilities": ["design-system"],
  "permissions": [],
  "secrets": [],
  "config_schema": {},
  "setup_flow": null,
  "health_check": { "kind": "none" },
  "nova_compat": ">=0.1.0 <1.0.0",
  "on_remove": { "delete": [], "keep": [], "export": [] },
  "tokens": {
    "bg/base": "#062a30",
    "bg/raised": "#0b3940",
    "bg/overlay": "#0f424a",
    "surface/card": "rgba(198, 236, 232, 0.12)",
    "surface/card-hover": "rgba(198, 236, 232, 0.18)",
    "text/primary": "#eefaf8",
    "text/secondary": "#bddad6",
    "text/faint": "#86aca7",
    "border/subtle": "rgba(198, 236, 232, 0.16)",
    "border/strong": "rgba(202, 237, 234, 0.42)",
    "accent/primary": "#5fe0c0",
    "accent/secondary": "#8fd4f0",
    "status/ok": "#72dca0",
    "status/working": "#5fe0c0",
    "status/waiting": "#b8d6d2",
    "status/attention": "#f2c46b",
    "status/error": "#ff9f96",
    "orb/core": "#5fe8c8",
    "orb/glow": "rgba(95, 232, 200, 0.45)",
    "orb/listening": "#8ff3dc",
    "orb/attention": "#f2b45a",
    "font/display": "-apple-system, \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif",
    "font/body": "-apple-system, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif",
    "font/mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "type/h1": "28px",
    "type/h2": "23px",
    "type/h3": "19px",
    "type/body": "16px",
    "type/small": "13px",
    "type/caption": "11px",
    "type/weight-regular": "400",
    "type/weight-strong": "600",
    "type/line-tight": "1.25",
    "type/line-body": "1.5",
    "space/1": "4px",
    "space/2": "8px",
    "space/3": "12px",
    "space/4": "16px",
    "space/5": "24px",
    "space/6": "32px",
    "space/7": "48px",
    "space/8": "64px",
    "radius/card": "12px",
    "radius/pill": "999px",
    "radius/input": "8px",
    "shadow/card": "0 1px 2px rgba(0, 16, 20, 0.32)",
    "shadow/raised": "0 12px 32px rgba(0, 16, 20, 0.48)",
    "blur/glass": "24px",
    "motion/breathe": "6000ms",
    "motion/pulse": "1800ms",
    "motion/transition": "225ms",
    "motion/duration-fast": "150ms",
    "motion/duration-slow": "300ms",
    "motion/ease": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "layout/rail-width": "84px",
    "layout/content-max": "720px",
    "layout/card-gap": "16px"
  },
  "modes": {},
  "reduced_motion": {},
  "orb_states": {
    "idle": { "color": "orb/core", "motion": "breathe", "light": "soft", "mark": "none", "reduced": { "light": "soft", "mark": "none" } },
    "listening": { "color": "orb/listening", "motion": "swirl", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "none" } },
    "working": { "color": "orb/core", "motion": "pulse", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "dashed" } },
    "speaking": { "color": "orb/core", "motion": "ripple", "light": "bright", "mark": "none", "reduced": { "light": "bright", "mark": "none" } },
    "needs-you": { "color": "orb/attention", "motion": "beckon", "light": "bright", "mark": "dashed", "reduced": { "light": "bright", "mark": "dashed" } },
    "stopped": { "color": "status/error", "motion": "alarm", "light": "stark", "mark": "ring", "reduced": { "light": "stark", "mark": "ring" } },
    "offline": { "color": "orb/core", "motion": "still", "light": "dim", "mark": "none", "reduced": { "light": "dim", "mark": "none" } }
  },
  "components": {
    "app": { "background": ["bg/base", "bg/raised", "orb/glow"] },
    "orb": { "core": "orb/core", "glow": "orb/glow", "listening": "orb/listening", "needs-you": "orb/attention", "stopped": "status/error" },
    "brief-card": { "background": "surface/card", "border": "border/subtle", "blur": "blur/glass", "radius": "radius/card" },
    "handling-card": { "background": "surface/card", "border": "border/subtle", "blur": "blur/glass", "radius": "radius/card" },
    "chat-bubble": { "nova": "surface/card", "person": "surface/card-hover" }
  },
  "content_rules": {},
  "extras": [],
  "preview": [],
  "ios_status_bar": "translucent"
}
