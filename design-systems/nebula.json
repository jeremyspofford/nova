{
  "id": "nebula",
  "version": "0.1.0",
  "kind": "design-system",
  "name": "Nebula",
  "description": "Nova's default look. Neutral surfaces, light or near-black, following your device; the nebula swirl only in the orb, the icon and state accents.",
  "capabilities": ["design-system"],
  "permissions": [],
  "secrets": [],
  "config_schema": {},
  "setup_flow": null,
  "health_check": { "kind": "none" },
  "nova_compat": ">=0.1.0 <1.0.0",
  "on_remove": { "delete": [], "keep": [], "export": [] },
  "tokens": {
    "bg/base": "#fbfbfc",
    "bg/raised": "#ffffff",
    "bg/overlay": "#ffffff",
    "surface/card": "#ffffff",
    "surface/card-hover": "#f1f1f4",
    "text/primary": "#17171c",
    "text/secondary": "#595964",
    "text/faint": "#82828c",
    "border/subtle": "#e5e5ea",
    "border/strong": "#82828c",
    "accent/primary": "#1d5fa6",
    "accent/secondary": "#8931b9",
    "status/ok": "#1f7a4a",
    "status/working": "#1d5fa6",
    "status/waiting": "#6b6b76",
    "status/attention": "#a2560a",
    "status/error": "#bc3734",
    "orb/core": "#1987ce",
    "orb/glow": "rgba(137, 49, 185, 0.30)",
    "orb/listening": "#b52d7e",
    "orb/attention": "#cb621b",
    "mark/left-outer": "#1f3d99",
    "mark/left-mid": "#1c5bbf",
    "mark/left-inner": "#0a6c9c",
    "mark/right-outer": "#6d2bb3",
    "mark/right-mid": "#a62a84",
    "mark/right-inner": "#b0470f",
    "font/display": "-apple-system, \"SF Pro Display\", \"Segoe UI\", system-ui, sans-serif",
    "font/body": "-apple-system, \"SF Pro Text\", \"Segoe UI\", system-ui, sans-serif",
    "font/mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "type/h1": "28px",
    "type/h2": "23px",
    "type/h3": "19px",
    "type/body": "16px",
    "type/small": "13px",
    "type/caption": "11px",
    "type/weight-regular": "400",
    "type/weight-strong": "600",
    "type/line-tight": "1.25",
    "type/line-body": "1.5",
    "space/1": "4px",
    "space/2": "8px",
    "space/3": "12px",
    "space/4": "16px",
    "space/5": "24px",
    "space/6": "32px",
    "space/7": "48px",
    "space/8": "64px",
    "radius/card": "12px",
    "radius/pill": "999px",
    "radius/input": "8px",
    "shadow/card": "0 1px 2px rgba(23, 23, 28, 0.06)",
    "shadow/raised": "0 12px 32px rgba(23, 23, 28, 0.16)",
    "blur/glass": "0px",
    "motion/breathe": "6000ms",
    "motion/pulse": "1800ms",
    "motion/transition": "225ms",
    "motion/duration-fast": "150ms",
    "motion/duration-slow": "300ms",
    "motion/ease": "cubic-bezier(0.25, 0.1, 0.25, 1)",
    "layout/rail-width": "84px",
    "layout/content-max": "720px",
    "layout/card-gap": "16px"
  },
  "modes": {
    "dark": {
      "bg/base": "#0f0e11",
      "bg/raised": "#151418",
      "bg/overlay": "#1b1a1f",
      "surface/card": "#151418",
      "surface/card-hover": "#1f1e23",
      "text/primary": "#ededf0",
      "text/secondary": "#a3a2ab",
      "text/faint": "#7d7c86",
      "border/subtle": "#26252b",
      "border/strong": "#6f6e78",
      "accent/primary": "#5cb3e4",
      "accent/secondary": "#ab3fe2",
      "status/ok": "#5fcf8f",
      "status/working": "#5cb3e4",
      "status/waiting": "#a3a2ab",
      "status/attention": "#f0a24a",
      "status/error": "#ee5050",
      "orb/core": "#25aaf7",
      "orb/glow": "rgba(171, 63, 226, 0.40)",
      "orb/listening": "#dc3b9c",
      "orb/attention": "#f37a23",
      "mark/left-outer": "#2f5bd3",
      "mark/left-mid": "#2f8be8",
      "mark/left-inner": "#25aaf7",
      "mark/right-outer": "#ab3fe2",
      "mark/right-mid": "#dc3b9c",
      "mark/right-inner": "#f37a23",
      "shadow/card": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "shadow/raised": "0 12px 32px rgba(0, 0, 0, 0.55)"
    }
  },
  "reduced_motion": {},
  "orb_states": {
    "idle": { "color": "orb/core", "motion": "breathe", "light": "soft", "mark": "none", "reduced": { "light": "soft", "mark": "none" } },
    "listening": { "color": "orb/listening", "motion": "swirl", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "none" } },
    "working": { "color": "orb/core", "motion": "pulse", "light": "full", "mark": "none", "reduced": { "light": "full", "mark": "dashed" } },
    "speaking": { "color": "orb/core", "motion": "ripple", "light": "bright", "mark": "none", "reduced": { "light": "bright", "mark": "none" } },
    "needs-you": { "color": "orb/attention", "motion": "beckon", "light": "bright", "mark": "dashed", "reduced": { "light": "bright", "mark": "dashed" } },
    "stopped": { "color": "status/error", "motion": "alarm", "light": "stark", "mark": "ring", "reduced": { "light": "stark", "mark": "ring" } },
    "offline": { "color": "orb/core", "motion": "still", "light": "dim", "mark": "none", "reduced": { "light": "dim", "mark": "none" } }
  },
  "components": {
    "app": { "background": "bg/base" },
    "orb": { "core": "orb/core", "glow": "orb/glow", "listening": "orb/listening", "needs-you": "orb/attention", "stopped": "status/error" }
  },
  "content_rules": {},
  "extras": [],
  "preview": [],
  "ios_status_bar": { "light": "default", "dark": "translucent" }
}
